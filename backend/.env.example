# Base de données PostgreSQL
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/boutik_dev?schema=public"

# JWT — générer deux valeurs longues et distinctes (ex. `openssl rand -base64 48`)
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_REFRESH_EXPIRES_IN="30d"

# Serveur
PORT=3001
CORS_ORIGIN="http://localhost:3000"
# Cookies d'authentification : laisser "true" dès que l'API est servie en HTTPS (les navigateurs
# traitent localhost comme sécurisé, donc "true" fonctionne aussi en local).
COOKIE_SECURE="true"
# À définir UNIQUEMENT derrière un reverse proxy (Render, Nginx, Cloudflare...) : nombre de
# sauts de proxy, ex. "1". Mal configuré, il permet de falsifier l'IP vue par l'anti-spam.
TRUST_PROXY=

# Compte administrateur de la PLATEFORME créé par le seed (obligatoire, aucune valeur par défaut :
# ce compte peut valider ou bannir n'importe quelle entreprise). Mot de passe : 10 caractères min.
SEED_PLATFORM_ADMIN_NAME="Administrateur Boutik"
SEED_PLATFORM_ADMIN_EMAIL=""
SEED_PLATFORM_ADMIN_PASSWORD=""

# Modération : email alerté (a) à chaque nouvelle entreprise à valider, (b) quand une entreprise
# atteint REPORT_ALERT_THRESHOLD signalements ouverts. Vide = pas d'alerte (la file d'attente
# reste consultable dans l'espace plateforme).
PLATFORM_ALERT_EMAIL=
REPORT_ALERT_THRESHOLD=3

# Upload des médias : stockage local par défaut ; Cloudinary si STORAGE_DRIVER=cloudinary et
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME (valeur EXACTE : une valeur mal formée
# fait planter le démarrage).
UPLOAD_DIR="uploads"
MAX_UPLOAD_SIZE_MB=5
STORAGE_DRIVER="local"
CLOUDINARY_URL=

# Envoi d'email (validation/refus/suspension d'une entreprise, confirmations de commande...) via
# l'API HTTP de Resend. Vide = les emails sont journalisés mais jamais envoyés.
# Clé API sur https://resend.com (commence par "re_").
RESEND_API_KEY=
# Expéditeur : le domaine doit être vérifié chez Resend ; "onboarding@resend.dev" ne sert qu'aux essais.
SMTP_FROM="Boutik <onboarding@resend.dev>"
