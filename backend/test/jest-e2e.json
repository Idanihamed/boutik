{
  "moduleFileExtensions": [
    "js",
    "json",
    "ts"
  ],
  "rootDir": ".",
  "testRegex": ".*\\.e2e-spec\\.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "testEnvironment": "node",
  "globalSetup": "<rootDir>/global-setup.ts",
  "setupFiles": [
    "<rootDir>/env.ts"
  ],
  "testTimeout": 60000,
  "moduleNameMapper": {
    "^sanitize-html$": "<rootDir>/stubs/sanitize-html.ts"
  }
}