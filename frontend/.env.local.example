# Adresse de l'API (jamais exposée au navigateur : les appels passent par /api sur ce site).
BACKEND_ORIGIN=http://localhost:3101

# Surveillance des erreurs (Sentry) — voir backend/.env.example pour la marche à suivre (même
# compte Sentry, un second projet de type "Next.js"). Vide = désactivée.
# SENTRY_DSN : erreurs de rendu serveur (composants serveur, routes). Reste privé (serveur uniquement).
SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN : erreurs dans le navigateur du visiteur. Volontairement exposé au
# navigateur (voir lib/sentry-client.ts) : ce n'est pas un secret, seulement une adresse de dépôt.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ENVIRONMENT="production"
NEXT_PUBLIC_SENTRY_ENVIRONMENT="production"
